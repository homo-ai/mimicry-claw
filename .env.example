# Anthropic API Key (for Anthropic provider)
# ANTHROPIC_API_KEY=

# OpenAI API Key (for OpenAI provider)
# OPENAI_API_KEY=

# Google API Key (for Google Gemini provider)
# GOOGLE_API_KEY=

# Default model to use
# DEFAULT_MODEL=claude-sonnet-4-20250514

# Default provider
# DEFAULT_PROVIDER=anthropic

# Permission mode: default, bypass, auto, plan, accept-edits
# PERMISSION_MODE=default

# Maximum turns per session
# MAX_TURNS=50

# Maximum budget in USD
# MAX_BUDGET_USD=100
